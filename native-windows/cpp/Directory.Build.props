<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(MSBuildThisFileDirectory)..\build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>false</MultiProcessorCompilation>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <ExceptionHandling>Sync</ExceptionHandling>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalOptions>/utf-8 /permissive- /MP2 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_UNICODE;UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)third_party\duckdb;$(MSBuildThisFileDirectory)third_party\mongodb-msvc\include\bson-2.5.5;$(MSBuildThisFileDirectory)third_party\mongodb-msvc\include\mongoc-2.5.5;$(MSBuildThisFileDirectory)core\include;$(MSBuildThisFileDirectory)core\include\native;$(MSBuildThisFileDirectory)services;$(MSBuildThisFileDirectory)platform;$(MSBuildThisFileDirectory)third_party;$(MSBuildThisFileDirectory)third_party\nlohmann;$(MSBuildThisFileDirectory)third_party\quickjs;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)third_party\duckdb;$(MSBuildThisFileDirectory)third_party\mongodb-msvc\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <HighEntropyVA>true</HighEntropyVA>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <StackReserveSize>8388608</StackReserveSize>
      <AdditionalDependencies>odbc32.lib;odbccp32.lib;ws2_32.lib;secur32.lib;crypt32.lib;bcrypt.lib;duckdb.lib;mongoc2.dll.lib;bson2.dll.lib;winhttp.lib;winsqlite3.lib;shlwapi.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;comctl32.lib;gdiplus.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <NativeRuntimeDll Include="$(MSBuildThisFileDirectory)third_party\duckdb\duckdb.dll" />
    <NativeRuntimeDll Include="$(MSBuildThisFileDirectory)third_party\mongodb-msvc\bin\bson2.dll" />
    <NativeRuntimeDll Include="$(MSBuildThisFileDirectory)third_party\mongodb-msvc\bin\mongoc2.dll" />
  </ItemGroup>
  <Target Name="CopyNativeProviderRuntime" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <Copy SourceFiles="@(NativeRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

